---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const services = [
  {
    icon: "集",
    title: "工业用品集中采购",
    text: "整合电子电器、电线电缆、包装耗材、办公劳保与 MRO 用品，减少多供应商沟通成本。",
  },
  {
    icon: "选",
    title: "低压电气选型支持",
    text: "根据系统电压、电流、分断能力、安装方式与项目图纸，协助确认良信对应型号。",
  },
  {
    icon: "价",
    title: "报价与交期确认",
    text: "提供清晰报价，确认现货、备货或订货周期，方便企业排期与成本核算。",
  },
  {
    icon: "库",
    title: "库存调度",
    text: "通过精细化订单处理与库存调度，兼顾常用物资供应和项目紧急需求。",
  },
  {
    icon: "运",
    title: "全国配送",
    text: "总部位于上海，面向全国工程项目、工厂、盘厂/成套厂与终端企业组织发货。",
  },
  {
    icon: "票",
    title: "开票与售后协同",
    text: "支持企业采购开票与对公结算，并协助处理到货核对、参数疑问和售后事项。",
  },
];
---

<BaseLayout
  title="工业配套与采购服务"
  description="上海弈藤为工程项目、工厂与终端企业提供工业用品集中采购、良信低压电气选型、报价、库存调度、全国配送、开票与售后支持。"
  path="/services/"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">服务支持</p>
      <h1>工业配套与低压电气一站式服务</h1>
      <p>
        从需求汇总、产品选型到库存调度、配送与开票，
        弈藤通过精细化订单管理帮助企业提升供应链运转效率。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {services.map((service) => (
          <article class="card">
            <span class="card-icon" aria-hidden="true">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid-2">
        <div class="card">
          <h3>询价需要提供什么？</h3>
          <p>
            工业用品可直接提供品名、规格、品牌和数量；良信低压电气可提供型号、
            电流、电压、极数、分断能力或项目图纸，弈藤协助核对后再报价。
          </p>
        </div>
        <div class="card">
          <h3>标准采购流程</h3>
          <p>
            汇总需求 → 型号确认 → 报价与交期 → 下单付款 → 库存调度与配送 →
            到货核对 → 开票归档。具体流程可按企业采购制度调整。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="text-align:center">
        <h2 style="margin-bottom:.8rem">提交工业配套需求</h2>
        <p style="color:var(--body);margin-bottom:1.4rem">
          电话或微信发来采购清单、型号或项目需求，弈藤尽快回复。
        </p>
        <div class="actions" style="justify-content:center">
          <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
            {SITE.contact.phoneDisplay}
          </a>
          <a class="btn btn--outline" href="/contact/">添加微信</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
