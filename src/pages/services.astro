---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const services = [
  {
    icon: "选",
    title: "选型与技术核对",
    text: "根据回路电流、系统电压、分断能力、安装方式与项目图纸，协助确认良信/常熟开关对应型号。",
  },
  {
    icon: "价",
    title: "报价与交期确认",
    text: "提供清晰报价，并确认现货、备货或订货交期，方便项目排期与成本核算。",
  },
  {
    icon: "库",
    title: "现货与常备库存",
    text: "良信全系列常备，主推微断、电子式塑壳、框架型号通常有现货，紧急需求可优先响应。",
  },
  {
    icon: "运",
    title: "全国配送",
    text: "总部位于上海，可向全国工程项目、盘厂/成套厂、电工安装队与终端企业发货。",
  },
  {
    icon: "技",
    title: "技术支持与售后",
    text: "协助处理参数疑问、到货核对与售后问题，配合厂家售后流程跟进处理。",
  },
  {
    icon: "票",
    title: "开票与采购流程",
    text: "支持按企业采购要求开票，方便对公结算、项目归档与审计留痕。",
  },
];
---

<BaseLayout
  title="服务支持"
  description="上海弈藤为工程项目商、盘厂/成套厂、电工安装队与终端企业提供良信/常熟断路器选型、报价、现货、配送、技术支持与开票一站式服务。"
  path="/services/"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">服务支持</p>
      <h1>断路器采购与项目配套服务</h1>
      <p>
        弈藤面向工程项目商、盘厂/成套厂、电工安装队和终端企业，
        提供从选型报价到配送开票的完整采购服务。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {services.map((service) => (
          <article class="card">
            <span class="card-icon" aria-hidden="true">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid-2">
        <div class="card">
          <h3>询价需要提供什么？</h3>
          <p>
            有明确型号的，直接报型号和数量；没有型号的，可提供电流、电压、极数、
            分断能力或项目图纸，弈藤协助选型后再报价。
          </p>
        </div>
        <div class="card">
          <h3>采购流程</h3>
          <p>
            确认型号 → 报价与交期 → 下单付款 → 发货配送 → 到货核对 → 开票归档。
            具体流程可按企业采购制度调整。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="text-align:center">
        <h2 style="margin-bottom:.8rem">开始询价</h2>
        <p style="color:var(--body);margin-bottom:1.4rem">
          电话或微信发来需求，弈藤尽快回复。
        </p>
        <div class="actions" style="justify-content:center">
          <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
            {SITE.contact.phoneDisplay}
          </a>
          <a class="btn btn--outline" href="/contact/">添加微信</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
