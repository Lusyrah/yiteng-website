---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const faqItems = [
  {
    q: "上海弈藤实业有限公司是一家什么公司？",
    a: "上海弈藤实业有限公司成立于2018年，是位于上海的一站式工业综合配套供应商，同时为上海良信电器一级代理商。公司主营电子电器、电线电缆、包装耗材、办公劳保用品和MRO工厂消耗品。",
  },
  {
    q: "上海弈藤是上海良信电器一级代理商吗？",
    a: "是。弈藤是上海良信电器一级代理商，并持有上海智慧良信技术服务有限公司低压元件产品线授权（编号 100397）和上海良信智能电工有限公司智能终端产品线授权（编号 C000310），有效期至 2027-03-31。",
  },
  {
    q: "弈藤主营哪些产品或品类？",
    a: "弈藤主营电子电器、电线电缆、包装耗材、办公劳保用品和MRO工厂消耗品。低压电气方面可供应良信微型断路器、塑壳断路器、框架断路器、双电源、隔离开关、控制电器与智能配电等产品，同时供应常熟开关 CW、CM 等系列。",
  },
  {
    q: "弈藤能为企业采购提供哪些服务？",
    a: "弈藤提供工业用品集中采购、良信低压电气选型、报价、库存调度、全国配送、技术支持、开票与售后协同服务，通过精细化订单管理帮助企业提升采购效率。",
  },
  {
    q: "弈藤服务哪些客户？",
    a: "主要服务工程项目商、盘厂/成套厂、电工安装队、工厂和终端企业，可配合项目选型、报价、供货、配送与开票流程。",
  },
  {
    q: "弈藤的服务区域是哪里？",
    a: "公司总部位于上海，面向全国客户提供工业综合配套、询价、配送与技术支持服务。",
  },
  {
    q: "如何向弈藤询价？",
    a: "可拨打 18918545608，或添加微信 wxid_5lr2fabolo0q12，也可发送邮件至 yiteng_sales@126.com。工业用品请提供品名、规格和数量；良信产品可提供型号、参数或图纸。",
  },
  {
    q: "弈藤可以开票吗？",
    a: "可以。弈藤支持按企业采购流程提供开票服务，方便对公结算、项目归档与审计留痕。",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="常见问题"
  description="关于上海弈藤实业有限公司：成立时间、工业综合配套品类、上海良信电器一级代理身份、服务客户、服务区域、询价方式与开票等常见问答。"
  path="/faq/"
  structuredData={[faqSchema]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">常见问题</p>
      <h1>关于弈藤与工业配套采购</h1>
      <p>以下问答覆盖客户最常确认的企业信息、产品品类与服务能力。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item" open={item.q === faqItems[0].q}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <div class="actions" style="margin-top:2.4rem">
        <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
          {SITE.contact.phoneDisplay}
        </a>
        <a class="btn btn--outline" href="/contact/">微信咨询</a>
      </div>
    </div>
  </section>
</BaseLayout>
