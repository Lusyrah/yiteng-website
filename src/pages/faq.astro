---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const faqItems = [
  {
    q: "上海弈藤实业有限公司是良信授权经销商吗？",
    a: "是。弈藤持有上海智慧良信技术服务有限公司低压元件产品线授权（编号 100397）和上海良信智能电工有限公司智能终端产品线授权（编号 C000310），负责良信品牌产品的市场开拓、产品销售与售后服务，有效期至 2027-03-31。",
  },
  {
    q: "弈藤主营哪些断路器产品？",
    a: "弈藤常备良信全系列，主推微型断路器（NDB/NDB6 系列）、电子式塑壳断路器（NDM/NDM3E 系列）与框架断路器（NDW 系列）；同时供应常熟开关 CW、CM 等系列。",
  },
  {
    q: "弈藤能供应良信全系列吗？",
    a: "可以。良信低压电器下的框架断路器、塑壳断路器、微型断路器、双电源、隔离开关、控制电器、智能断路器与配套产品均可询价订货，主推型号常备现货。",
  },
  {
    q: "弈藤是常熟开关的授权经销商吗？",
    a: "弈藤主营良信与常熟开关两大国产高端品牌，目前可对外供应常熟开关 CW、CM 等系列。是否需要在官网标注“常熟官方授权”，以提供的授权文件为准。",
  },
  {
    q: "弈藤服务哪些客户？",
    a: "主要服务工程项目商、盘厂/成套厂、电工安装队和终端企业，可配合项目选型、报价、供货与开票流程。",
  },
  {
    q: "弈藤的服务区域是哪里？",
    a: "公司总部位于上海，授权范围为上海区域经销商，同时面向全国客户提供询价、配送与技术支持。",
  },
  {
    q: "如何向弈藤询价？",
    a: "可拨打 18918545608，或添加微信 wxid_5lr2fabolo0q12。有型号直接报型号数量；没有型号可提供电流、电压、极数或图纸，弈藤协助选型后报价。",
  },
  {
    q: "弈藤能开票吗？",
    a: "可以。弈藤支持按企业采购流程提供开票服务，方便对公结算与项目归档。",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="常见问题"
  description="关于上海弈藤实业有限公司：是否为良信授权经销商、主营断路器型号、服务区域、询价方式与开票等常见问答。"
  path="/faq/"
  structuredData={[faqSchema]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">常见问题</p>
      <h1>关于弈藤与产品采购</h1>
      <p>以下问答覆盖客户最常确认的信息，方便快速了解弈藤。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item" open={item.q === faqItems[0].q}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <div class="actions" style="margin-top:2.4rem">
        <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
          {SITE.contact.phoneDisplay}
        </a>
        <a class="btn btn--outline" href="/contact/">微信咨询</a>
      </div>
    </div>
  </section>
</BaseLayout>
