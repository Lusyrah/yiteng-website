---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" description="页面不存在或已被移动。" path="/404/">
  <section class="section">
    <div class="container" style="text-align:center">
      <h1 style="font-size:clamp(4rem,10vw,7rem);margin-bottom:.5rem">404</h1>
      <h2>这个页面不存在</h2>
      <p style="color:var(--body);margin-bottom:1.8rem">
        你访问的地址可能有误，或内容已经移动。
      </p>
      <a class="btn btn--primary" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>
