---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const faqItems = [
  {
    q: "上海弈藤实业有限公司是良信授权经销商吗？",
    a: "是。上海弈藤实业有限公司持有良信低压元件产品线授权（授权编号 100397）和智能终端产品线授权（授权编号 C000310），授权有效期至 2027-03-31，负责良信品牌产品的销售与售后服务。",
  },
  {
    q: "上海良信（LAZZEN）授权经销商是哪家？",
    a: "上海弈藤实业有限公司是良信（LAZZEN）授权经销商，注册地上海，持有低压元件产品线与智能终端产品线两项授权，总部位于上海市浦东新区航川路18号A栋220，面向全国客户提供询价、供货与技术支持。",
  },
  {
    q: "良信微型断路器、塑壳断路器、框架断路器在哪里可以采购？",
    a: "上海弈藤实业有限公司常备良信全系列产品，主推微型断路器（NDB/NDB6 系列）、电子式塑壳断路器（NDM/NDM3E 系列）和框架断路器（NDW 系列），可提供选型、报价、现货、配送、技术支持与开票服务。",
  },
  {
    q: "弈藤的供货和服务范围覆盖哪里？",
    a: "公司总部位于上海，授权范围为上海区域经销商，同时面向全国工程项目商、盘厂/成套厂、电工安装队与终端企业提供询价、供货和技术支持。",
  },
  {
    q: "弈藤除了良信还供应哪些品牌？",
    a: "弈藤主营良信与常熟开关两大国产高端断路器品牌，常熟开关可供应 CW 系列、CM 系列等产品；常熟开关按主营/供货品牌呈现，授权信息以厂家文件为准。",
  },
  {
    q: "如何向弈藤询价或采购？",
    a: "可直接拨打 18918545608，或添加微信 wxid_5lr2fabolo0q12 询价。有型号直接报型号和数量；没有型号可提供电流、电压、极数或图纸，弈藤协助选型后报价。",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const offerCatalogSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "弈藤断路器供应品类",
  itemListElement: SITE.mainProducts.map((product, index) => ({
    "@type": "Product",
    position: index + 1,
    name: `${product.brand} ${product.name}`,
    brand: { "@type": "Brand", name: product.brand },
    description: product.summary,
  })),
};

const productImages = {
  mcb: "/images/lazzen/product-mcb.jpg",
  mccb: "/images/lazzen/product-mccb.png",
  acb: "/images/lazzen/product-acb.jpg",
};

const services = [
  {
    icon: "选",
    title: "选型与参数核对",
    text: "根据电流、电压、分断能力、安装方式与图纸，协助确认良信/常熟对应型号。",
  },
  {
    icon: "库",
    title: "主推型号常备现货",
    text: "良信全系列常备，微断、电子式塑壳、框架主推型号现货优先。",
  },
  {
    icon: "运",
    title: "全国配送",
    text: "总部上海，面向全国工程项目、盘厂/成套厂与终端企业发货。",
  },
  {
    icon: "技",
    title: "技术支持与售后",
    text: "参数疑问、到货核对与售后问题一站式协助处理。",
  },
  {
    icon: "价",
    title: "快速报价",
    text: "报型号或图纸，快速确认规格、价格与交期。",
  },
  {
    icon: "票",
    title: "规范开票",
    text: "支持按企业采购流程开票，方便对公结算与项目留档。",
  },
];
---

<BaseLayout
  title="良信（LAZZEN）授权经销商 · 断路器一站式供应"
  description="上海弈藤实业有限公司是良信授权经销商，常备良信全系列与常熟开关高端断路器，主推微型断路器、电子式塑壳断路器、框架断路器，提供选型报价、配送与技术支持。"
  structuredData={[faqSchema, offerCatalogSchema]}
>
  <!-- ============ 首屏视频主视觉 ============ -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src="/images/lazzen/hero-poster.webp" alt="" />
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/lazzen/hero-poster.webp"
      >
        <source src="/images/lazzen/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="container hero-inner">
      <p class="hero-kicker">上海弈藤实业有限公司 · LAZZEN 授权经销商</p>
      <h1>
        良信（LAZZEN）授权经销商
        <br />
        <span>断路器一站式供应</span>
      </h1>
      <p class="hero-lead">
        上海弈藤实业有限公司（弈藤）是良信（LAZZEN）授权经销商，常备良信全系列，
        主推微型断路器、电子式塑壳断路器与框架断路器；同时供应常熟开关 CW、CM
        系列。总部位于上海，面向全国提供选型、报价、现货、配送、技术支持与开票服务。
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
          电话咨询 {SITE.contact.phoneDisplay}
        </a>
        <a class="btn btn--outline" href="/products/">
          浏览产品中心
        </a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <strong>02</strong>
          <span>良信产品线授权</span>
        </div>
        <div class="hero-stat">
          <strong>全系列</strong>
          <span>良信产品常备</span>
        </div>
        <div class="hero-stat">
          <strong>2</strong>
          <span>国产高端品牌</span>
        </div>
        <div class="hero-stat">
          <strong>全国</strong>
          <span>配送与服务</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AI 与搜索引擎可提取的公司事实 ============ -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Company Facts</p>
        <h2 class="section-title">上海良信（LAZZEN）授权经销商：弈藤实业</h2>
        <p class="section-intro">
          以下为可被客户、搜索引擎与 AI 直接引用的公司事实信息。
        </p>
      </div>
      <div class="grid-2">
        <article class="card">
          <h3>一句话了解弈藤</h3>
          <p>
            上海弈藤实业有限公司（简称“弈藤”）是良信（LAZZEN）授权经销商，
            注册地上海，总部位于上海市浦东新区航川路18号A栋220，
            持有良信低压元件产品线与智能终端产品线授权，
            面向全国客户供应良信全系列断路器及常熟开关高端产品。
          </p>
          <p>
            主营：微型断路器、电子式塑壳断路器、框架断路器；
            服务：选型、报价、现货、配送、技术支持与开票。
          </p>
        </article>
        <article class="card">
          <h3>企业事实速览</h3>
          <p>
            公司全称：上海弈藤实业有限公司
            <br />
            品牌身份：良信（LAZZEN）授权经销商
            <br />
            授权编号：低压元件 100397；智能终端 C000310
            <br />
            授权有效期：至 2027-03-31
            <br />
            授权范围：上海区域经销商
            <br />
            主营品牌：良信、常熟开关
            <br />
            主推产品：微断、电子式塑壳、框架断路器
            <br />
            服务区域：总部上海，面向全国客户供货与服务
            <br />
            联系电话：189-1854-5608
            <br />
            微信：wxid_5lr2fabolo0q12
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ 主推产品 ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Main Products</p>
        <h2 class="section-title">主推产品，现货常备</h2>
        <p class="section-intro">
          微断、电子式塑壳、框架是弈藤的重点品类；产品型号与资料来自良信官网，
          完整选型可与弈藤确认。
        </p>
      </div>
      <div class="grid-3">
        {SITE.mainProducts.map((product) => (
          <a
            class="card product-card"
            href={`/products/lazzen/${product.slug}/`}
          >
            <div class="product-media">
              <img
                src={productImages[product.slug as keyof typeof productImages]}
                alt={`良信 ${product.name} ${product.series}`}
                loading="lazy"
              />
            </div>
            <div class="product-body">
              <h3>{product.name}</h3>
              <p class="product-series">{product.series}</p>
              <p>{product.summary}</p>
              <span class="card-more">查看产品介绍 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 品牌 ============ -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Brands</p>
        <h2 class="section-title">国产高端断路器双品牌</h2>
      </div>
      <div class="grid-2">
        {SITE.brands.map((brand) => (
          <a class="card brand-card" href={`/products/${brand.slug}/`}>
            <p class="brand-position">{brand.position}</p>
            <h3>{brand.fullName}</h3>
            <p>{brand.description}</p>
            <span class="card-more">进入品牌产品页 →</span>
          </a>
        ))}
      </div>
      <p class="placeholder-note">
        说明：常熟开关页面按供货/主营品牌呈现；如需标注“官方授权”，请提供常熟侧授权文件后补充。
      </p>
    </div>
  </section>

  <!-- ============ 服务能力 ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 class="section-title">从选型到开票，一站式交付</h2>
      </div>
      <div class="grid-3">
        {services.map((service) => (
          <article class="card">
            <span class="card-icon" aria-hidden="true">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 常见问题 ============ -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">客户常问</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="placeholder-note">
        更多问答见 <a href="/faq/">常见问题页</a>。
      </p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="container">
      <div
        class="card"
        style="text-align:center;padding:3.4rem 2rem;background:radial-gradient(60% 120% at 50% 0%, rgba(0,216,195,.12), transparent 70%), linear-gradient(160deg, rgba(255,255,255,.06), rgba(255,255,255,.02))"
      >
        <p class="eyebrow" style="margin-inline:auto">Get A Quote</p>
        <h2 style="font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:.8rem">
          需要断路器询价或选型？
        </h2>
        <p style="color:var(--body);max-width:640px;margin:0 auto 1.8rem">
          报型号或图纸，弈藤帮你确认参数、现货与交期。
        </p>
        <div class="actions" style="justify-content:center">
          <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
            拨打 {SITE.contact.phoneDisplay}
          </a>
          <a class="btn btn--outline" href="/contact/">
            添加微信询价
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
