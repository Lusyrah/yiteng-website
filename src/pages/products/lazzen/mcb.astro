---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE } from "../../../config";
import { mcbSeries, LAZZEN_OFFICIAL } from "../../../data/lazzen";

const faqItems = [
  {
    q: "哪里可以买良信 NDB/NDB6 微型断路器？",
    a: "上海弈藤实业有限公司作为上海良信电器一级代理商，可供应 NDB/NDB6 系列微型断路器，并提供选型、报价、配送与技术支持。",
  },
  {
    q: "良信微型断路器适合哪些场景？",
    a: "适用于工业、民用建筑、能源、通信及基础建设等低压终端配电；另有电信机柜 1U、DC1200V 光伏、物联网剩余电流等细分型号。",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title="良信微型断路器 NDB/NDB6"
  description="上海弈藤作为上海良信电器一级代理商，可供应良信（LAZZEN）微型断路器 NDB、NDB6 系列：NDB2Z、NDB6-125、1U 机柜型、DC1200V 直流型、物联网剩余电流断路器等。"
  path="/products/lazzen/mcb/"
  structuredData={[faqSchema]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div>
        <p class="eyebrow">良信 · 低压电器</p>
        <h1>微型断路器（MCB）</h1>
        <p>
          NDB、NDB6 系列微型断路器主要用于低压终端配电线路的过载与短路保护，覆盖工业、民用建筑、能源、通信与光伏等场景。
        </p>
      </div>
      <div class="page-hero-visual">
        <img
          src="/images/lazzen/product-mcb.jpg"
          alt="良信 NDB 系列微型断路器"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">主推系列</p>
        <h2 class="section-title">弈藤常备的微断型号</h2>
        <p class="section-intro">型号介绍整理自良信官网，产品图片与正式选型资料可向弈藤索取。</p>
      </div>
      <div style="display:grid;gap:1.2rem">
        {mcbSeries.map((series) => (
          <article class="card">
            <h3>{series.name}</h3>
            <p>{series.summary}</p>
            <p class="placeholder-note" style="margin-bottom:0">
              官方资料：
              <a href={series.page} target="_blank" rel="noopener">
                良信官网 {series.name}
              </a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">常见问题</p>
        <h2 class="section-title">关于良信微断</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="text-align:center">
        <h2 style="margin-bottom:.8rem">需要微断型号报价？</h2>
        <p style="color:var(--body);margin-bottom:1.4rem">
          报型号或回路参数，弈藤帮你确认规格与现货。
        </p>
        <div class="actions" style="justify-content:center">
          <a class="btn btn--primary" href={`tel:${SITE.contact.phone}`}>
            {SITE.contact.phoneDisplay}
          </a>
          <a class="btn btn--outline" href="/contact/">微信询价</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
